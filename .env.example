# Environment configuration for whois-blog

# Node environment
NODE_ENV=production

# Admin credentials (used by prisma/seed.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-secure-32-char-random-string

# App URL (no trailing slash - for Vercel, e.g. https://your-blog.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For local dev & unit tests (SQLite):
DATABASE_URL=file:./dev.db
# For Docker Compose:
# DATABASE_URL=file:/app/data/dev.db

# For Production with Turso libSQL (Cloud SQLite - No credit card required):
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# -----------------------------------------------------------------------------
# Media / Object Storage (S3 / Supabase / MinIO)
# -----------------------------------------------------------------------------
# For local dev with MinIO:
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=whois-blog-media

# For Production with Supabase Storage (Free 1 GB - Public Buckets 100% Free - No card required):
# MINIO_ENDPOINT=https://<your-project-ref>.storage.supabase.co/v1/s3
# MINIO_ACCESS_KEY=<your-supabase-s3-access-key-id>
# MINIO_SECRET_KEY=<your-supabase-s3-secret-access-key>
# MINIO_BUCKET=whois-blog-media
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://<your-project-ref>.supabase.co/storage/v1/object/public/whois-blog-media
# STORAGE_SKIP_ENSURE_BUCKET=true

# -----------------------------------------------------------------------------
# OAuth providers (Optional - for guest OAuth login & commenting)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
