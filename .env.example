# Environment configuration for whois-blog

# Node environment
NODE_ENV=production

# Admin credentials (used by prisma/seed.js / prisma/seed.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-secure-32-char-random-string

# App URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Database (SQLite)
# For local dev: file:./dev.db
# For Docker: file:/app/data/dev.db
DATABASE_URL=file:./dev.db

# OAuth providers (Optional - required for guest OAuth login & commenting)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MinIO / S3 object storage
# For local dev: http://localhost:9000
# For Docker Compose: http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=whois-blog-media
